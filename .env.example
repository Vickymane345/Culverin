# Copy to .env.local for local development, and add the same keys in Vercel
# (Project > Settings > Environment Variables) for production.

# Live domain, no trailing slash. Used for canonical URLs, sitemap, emails and Paystack callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack: Settings > API Keys & Webhooks (use sk_test_ while testing)
PAYSTACK_SECRET_KEY=

# Optional email via https://resend.com. Without these, orders still work but no emails go out.
RESEND_API_KEY=
EMAIL_FROM="Culverin Quantum <orders@yourdomain.com>"
# Inbox that receives new order, repair and enquiry alerts
STAFF_NOTIFY_EMAIL=

# Contact details shown on the site
NEXT_PUBLIC_CONTACT_EMAIL=hello@culverinquantum.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP=

# Search engine ownership tags (Google Search Console > HTML tag, Bing Webmaster Tools)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
