# Copy to .env.local for local development, and add the same keys in Vercel
# (Project > Settings > Environment Variables) for production.

# Live domain, no trailing slash. Used for canonical URLs, sitemap, emails and OPay callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# OPay merchant checkout: OPay Business dashboard > Developers / API keys.
# Set OPAY_ENV=sandbox with sandbox keys while testing; leave unset for live.
OPAY_MERCHANT_ID=
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
OPAY_ENV=

# Optional email via https://resend.com. Without these, orders still work but no emails go out.
RESEND_API_KEY=
EMAIL_FROM="Culverin Quantum <orders@yourdomain.com>"
# Inbox that receives new order, repair and enquiry alerts
STAFF_NOTIFY_EMAIL=

# Contact details shown on the site
NEXT_PUBLIC_CONTACT_EMAIL=hello@culverinquantum.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP=
# Name on the UBA account customers transfer to (shown at checkout)
NEXT_PUBLIC_BANK_ACCOUNT_NAME=

# Search engine ownership tags (Google Search Console > HTML tag, Bing Webmaster Tools)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Cloudflare R2 (product photos). See SETUP.md section 3b.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=culverin-images
R2_PUBLIC_URL=

# Protects /api/cron/keepalive (Vercel sends it automatically)
CRON_SECRET=
